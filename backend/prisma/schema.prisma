generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id        String   @id @default(uuid())
  memberCode String  @unique
  name      String
  email     String?  @unique
  phone     String?
  avatarUrl String?
  status    String   @default("ACTIVE")
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  passwordHash String?
  emailVerifiedAt DateTime?
  
  sessions       Session[]
  gymStaff       GymStaff[]
  preferences    MemberPreference?
  savedLocations SavedLocation[]
  memberships    Membership[]
  savedGyms      SavedGym[]
  checkIns       CheckIn[]
  reviews        Review[]
}

model MemberPreference {
  id                   String   @id @default(uuid())
  memberId             String   @unique
  member               Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fitnessGoal          String?
  preferredWorkoutTime String?
  preferredDistanceKm  Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model SavedLocation {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  label     String
  name      String?
  address   String
  area      String?
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Gym {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  logoUrl     String?
  description String?
  verified    Boolean  @default(false)
  accessTier  String   @default("STANDARD")
  phone       String?
  email       String?
  address     String
  area        String?
  city        String?
  latitude    Float?
  longitude   Float?
  capacity    Int?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images       GymImage[]
  amenities    GymAmenity[]
  openingHours GymOpeningHour[]
  savedGyms    SavedGym[]
  checkIns     CheckIn[]
  reviews      Review[]
  trainers     Trainer[]
  staff        GymStaff[]
}

model GymImage {
  id        String   @id @default(uuid())
  gymId     String
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  url       String
  type      String   @default("GALLERY")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Amenity {
  id       String   @id @default(uuid())
  slug     String   @unique
  name     String
  iconKey  String?
  gyms     GymAmenity[]
}

model GymAmenity {
  gymId     String
  amenityId String
  gym       Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([gymId, amenityId])
}

model GymOpeningHour {
  id        String  @id @default(uuid())
  gymId     String
  gym       Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  dayOfWeek String
  openTime  String?
  closeTime String?
  isClosed  Boolean @default(false)
}

model MembershipPlan {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String?
  priceMonthly  Int
  visitLimit    Int?
  accessTier    String   @default("STANDARD")
  freezeAllowed Boolean  @default(false)
  active        Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   Membership[]
}

model Membership {
  id            String         @id @default(uuid())
  memberId      String
  member        Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId        String
  plan          MembershipPlan @relation(fields: [planId], references: [id])
  status        String         @default("ACTIVE")
  startsAt      DateTime
  renewsAt      DateTime?
  endsAt        DateTime?
  visitsUsed    Int            @default(0)
  cycleStartsAt DateTime?
  cycleEndsAt   DateTime?
  autoRenew     Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  checkIns      CheckIn[]
}

model SavedGym {
  memberId  String
  gymId     String
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@id([memberId, gymId])
}

model CheckIn {
  id           String     @id @default(uuid())
  memberId     String
  gymId        String
  membershipId String
  method       String     @default("DEMO")
  status       String     @default("PENDING")
  checkedInAt  DateTime   @default(now())
  createdAt    DateTime   @default(now())

  member       Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gym          Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  memberId  String
  gymId     String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
}

model Trainer {
  id              String  @id @default(uuid())
  gymId           String
  gym             Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name            String
  avatarUrl       String?
  specialty       String?
  experienceYears Int?
  bio             String?
}

model Session {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())
  ipAddress String?
  userAgent String?
}

model GymStaff {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gymId     String
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  role      String   @default("OWNER")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, gymId])
}
