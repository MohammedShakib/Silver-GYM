# Environment
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Database (Required)
DATABASE_URL=postgresql://user:password@localhost:5432/silvergym?schema=public

# Session / Auth (Required)
# Generate a secure 32+ char string
SESSION_SECRET=your_super_secret_session_key_here

# Email Provider
# Options: DEV, RESEND, SMTP
EMAIL_PROVIDER=DEV
EMAIL_FROM=noreply@silvergym.com
EMAIL_API_KEY=

# Payments
# Options: SANDBOX, STRIPE, SSLCOMMERZ
PAYMENT_PROVIDER=SANDBOX
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Payouts
PAYOUT_PROVIDER=MANUAL
PAYOUT_API_KEY=

# QR / Check-In
QR_SIGNING_SECRET=generate_a_random_secure_secret_for_qr_passes
QR_TTL_SECONDS=30

# Background Workers
NOTIFICATION_WORKER_INTERVAL=5000
RENEWAL_SCHEDULER_INTERVAL=3600000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
